# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.
#
# The router section is only needed when running with --router.

# --- Router connection ---
# Driver: auto, huawei_dg8045, or a plugin path such as my_router:MyDriver.
ROUTER_DRIVER=auto

# Extra plugin modules to import (comma-separated). They can register
# drivers/strategies for auto-detection or by name.
# ROUTER_PLUGINS=my_router,my_ip
ROUTER_HOST=192.168.1.1
ROUTER_PORT=443
ROUTER_USER=your-router-username
ROUTER_PASS=your-router-password

# --- IP-change method ---
# Strategy: pppoe_wan, or a plugin path such as my_ip:MyStrategy.
IP_CHANGE_STRATEGY=pppoe_wan

# Comma-separated WAN names, in the order they should be restarted.
ROUTER_WANS=your-wan-name-1,your-wan-name-2

# Fail fast when no gateway answers (seconds).
# ROUTER_CONNECT_TIMEOUT=3

# --- Optional OpenCode overrides ---
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVICE_JSON=~/.config/opencode/service.json
# OPENCODE_SESSION_ID=ses_...
